# Copy this file to .env and fill in the values. The .env file is never committed.

# Your TMDB credential: either the short "API Key" or the long "API Read Access Token"
# (TMDB account > Settings > API).
TMDB_API_KEY=

# Optional on the PC. In Docker (and so on the Pi) debug is always off, and a long random DJANGO_SECRET_KEY is
# required. Make one with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# Comma-separated; add the PC's address to open the app from the phone.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the database file lives. Leave it out on the PC: the file is then db.sqlite3 in the project folder.
# Docker sets it by itself (to the volume), so it does not go in .env there either.
# DJANGO_DB_PATH=

# Where the daily database backups go: Cloudflare R2. Only fill these in on the Pi (docs/deploying.md).
# Left empty on the PC, so the PC makes no backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Rule of thumb: ignore what can be rebuilt, what is secret, and what is private.
# Everything else is committed.

# --- Can be rebuilt (npm install / npm run build bring these back) ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.eslintcache

# --- Secrets: never commit. The example file (names only, no values) is fine. ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Private data: the database holds my account and watch history ---
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
/data/
/backups/

# --- Test output ---
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Computer and editor noise ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# --- Claude Code: personal/local state. The skills in .claude/skills ARE committed. ---
.claude/settings.local.json
.claude/worktrees/
graphify-out/
